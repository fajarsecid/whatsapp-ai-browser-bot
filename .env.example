# AI browser service: gemini atau chatgpt
WEB_AI_SERVICE=gemini

# WhatsApp/Baileys session
AUTH_DIR=./session
USE_PAIRING_CODE=true
PAIRING_PHONE_NUMBER=

# Browser profile.
# Kosongkan BROWSER_PROFILE kalau ingin default otomatis:
# - Gemini: ./browser-profile-gemini
# - ChatGPT: ./browser-profile
BROWSER_PROFILE=
BROWSER_USER_AGENT=
WEB_AI_HEADLESS=false

# Mode jawaban default: auto, instant, thinking, atau pro.
# Catatan: pro hanya mode native Gemini. Saat ChatGPT aktif, pro diarahkan ke thinking.
AI_MODE=auto
AI_MODE_FILE=./ai-modes.json
AI_SERVICE_FILE=./ai-services.json

# Remote login panel
REMOTE_LOGIN_HOST=0.0.0.0
REMOTE_LOGIN_PORT=8787
REMOTE_LOGIN_TOKEN=
REMOTE_LOGIN_PUBLIC_URL=

# ChatGPT cookie opsional. Login manual tidak membutuhkan cookie.
CHATGPT_COOKIE_FILE=./cookie.js
CHATGPT_USER_AGENT=
CHATGPT_HEADLESS=false

# Browser session behavior
WEB_AI_SESSION_IDLE_MS=300000
WEB_AI_MAX_ATTEMPTS=2
MAX_QUEUE_PER_CHAT=2

# Response send tuning.
# Lebih kecil = balasan WhatsApp lebih cepat setelah AI selesai, tapi terlalu kecil bisa berisiko menangkap teks yang belum final.
ANSWER_STABLE_INTERVAL_MS=300
ANSWER_STABLE_CHECKS=2
LOG_LEVEL=silent
