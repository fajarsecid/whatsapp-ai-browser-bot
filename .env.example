PORT=3000

# AI provider:
# - "web" buka layanan AI web di browser, tanpa API key dan tanpa model lokal.
AI_PROVIDER=web

# Web AI, hanya dipakai kalau AI_PROVIDER=web
# WEB_AI_SERVICE bisa: chatgpt, gemini, copilot, perplexity, all, custom
WEB_AI_SERVICE=chatgpt
WEB_AI_URL=
WEB_AI_INCLUDE_CONTEXT=false

# Bot behavior
SESSION_TTL_MINUTES=180
MAX_HISTORY_TURNS=8
REQUEST_TIMEOUT_MS=45000
BOT_PREFIX=
REPLY_IN_GROUPS=false
AUTH_DIR=auth_info_baileys
USE_PAIRING_CODE=true
PAIRING_PHONE_NUMBER=
PAIRING_CODE=
SYSTEM_PROMPT=Kamu adalah asisten AI yang membantu lewat WhatsApp. Jawab dalam bahasa pengguna, ringkas, jelas, dan praktis.

# ChatGPT web automation
# Cookie cf_clearance sering terikat ke user-agent browser tempat cookie diambil.
# Kosongkan untuk default Playwright, atau isi navigator.userAgent dari browser sumber cookie.
CHATGPT_USER_AGENT=
CHATGPT_HEADLESS=false
