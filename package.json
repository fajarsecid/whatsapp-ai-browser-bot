{
  "name": "whatsapp-ai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp bot that asks AI through browser web UIs.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "WEB_AI_HEADLESS=false xvfb-run -a node index.js",
    "start:gemini": "WEB_AI_SERVICE=gemini WEB_AI_HEADLESS=false xvfb-run -a node index.js",
    "start:chatgpt": "WEB_AI_SERVICE=chatgpt WEB_AI_HEADLESS=false xvfb-run -a node index.js",
    "login": "node login.js",
    "login:chatgpt": "node login.js chatgpt",
    "login:gemini": "node login.js gemini",
    "remote-login:chatgpt": "xvfb-run -a node scripts/remote-login.js chatgpt",
    "remote-login:gemini": "xvfb-run -a node scripts/remote-login.js gemini",
    "check:chatgpt": "node scripts/check-chatgpt-session.js",
    "check:chatgpt:xvfb": "CHATGPT_HEADLESS=false xvfb-run -a node scripts/check-chatgpt-session.js",
    "check:gemini:xvfb": "WEB_AI_HEADLESS=false xvfb-run -a node scripts/check-gemini-session.js",
    "dev": "node --watch index.js",
    "test": "node --check index.js && node --check login.js && node --check src/browser-profile.js && node --check scripts/check-chatgpt-session.js && node --check scripts/check-gemini-session.js && node --check scripts/inspect-gemini-modes.js && node --check scripts/inspect-chatgpt-modes.js && node --check scripts/remote-login.js && node --test test/browser-profile.test.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "pino": "^8.21.0",
    "playwright": "^1.52.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  }
}
